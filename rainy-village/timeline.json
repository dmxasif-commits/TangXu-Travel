    {"id": "l1", "t": 1.0,  "text": "It starts with one drop."},
    {"id": "l2", "t": 5.0,  "text": "High in the mountains, the cloud lets go."},
    {"id": "l3", "t": 10.3, "text": "Roofs drink first. Then the stones. Then the stream."},
    {"id": "l4", "t": 15.3, "text": "Somewhere below, one red umbrella is walking home."},
    {"id": "l5", "t": 22.0, "text": "One lit window is enough."},
    {"id": "l6", "t": 26.0, "text": "Rain, again. Stay a little longer."}
