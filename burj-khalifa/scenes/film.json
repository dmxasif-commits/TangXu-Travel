   "t0": 0.5,
   "t1": 3.88,
   "zh": "দুবাইয়ের আকাশে মাথা তুলে দাঁড়িয়ে আছে বুর্জ খলিফা।",
   "en": "",
   "speech": 2.896
  },
  {
   "t0": 3.9,
   "t1": 6.096,
   "zh": "উচ্চতা ৮২৮ মিটার।",
   "en": "",
   "speech": 1.596
  },
  {
   "t0": 6.3,
   "t1": 8.071,
   "zh": "নিচ থেকে তাকালে প্রশ্ন জাগে",
   "en": "",
   "speech": 1.791
  },
  {
   "t0": 8.091,
   "t1": 12.78,
   "zh": "এত উঁচু, এত সরু একটা ভবন বাতাসের চাপ সামলে দাঁড়িয়ে থাকে কীভাবে?",
   "en": "",
   "speech": 4.313
  },
  {
   "t0": 12.8,
   "t1": 16.476,
   "zh": "এই প্রশ্নের উত্তর খুঁজতেই আজকের ইঞ্জিনিয়ারিং ডায়েরি।",
   "en": "",
   "speech": 3.076
  },
  {
   "t0": 16.8,
   "t1": 20.336,
   "zh": "তবে গল্পটা শুরু হবে আকাশে নয় — মাটির নিচে।",
   "en": "",
   "speech": 2.936
  },
  {
   "t0": 20.4,
   "t1": 23.98,
   "zh": "২০০৪ সালের জানুয়ারিতে শুরু হয় খননকাজ।",
   "en": "",
   "speech": 3.058
  },
  {
   "t0": 24.0,
   "t1": 26.134,
   "zh": "এমন একটা ভবনের পুরো ওজন বহন করার",
   "en": "",
   "speech": 2.154
  },
  {
   "t0": 26.154,
   "t1": 28.319,
   "zh": "জন্য দরকার ছিল বিশেষ ভিত্তি।",
   "en": "",
   "speech": 1.885
  },
  {
   "t0": 28.4,
   "t1": 31.98,
   "zh": "মাটির নিচে তৈরি করা হয় শক্তিশালী কংক্রিটের পাইল।",
   "en": "",
   "speech": 2.98
  },
  {
   "t0": 32.0,
   "t1": 34.021,
   "zh": "তার ওপর বসানো হয় পুরু, রড দিয়ে",
   "en": "",
   "speech": 2.041
  },
  {
   "t0": 34.041,
   "t1": 35.968,
   "zh": "শক্ত করা কংক্রিটের ভিত্তি।",
   "en": "",
   "speech": 1.658
  },
  {
   "t0": 36.0,
   "t1": 38.388,
   "zh": "ওপরের ভবনের ভার এই ভিত্তি হয়ে পাইলগুলোর",
   "en": "",
   "speech": 2.408
  },
  {
   "t0": 38.408,
   "t1": 40.208,
   "zh": "মাধ্যমে মাটিতে পৌঁছায়।",
   "en": "",
   "speech": 1.384
  },
  {
   "t0": 43.3,
   "t1": 46.702,
   "zh": "কিন্তু মজবুত ভিত্তি তৈরি করলেই তো কাজ শেষ নয়।",
   "en": "",
   "speech": 2.802
  }
 ],
